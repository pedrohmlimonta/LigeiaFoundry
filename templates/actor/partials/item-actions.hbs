{{!-- Botões de rolagem por AÇÃO de um item, na ficha do personagem.
      Espera: item (com _actionsView, já filtrado pelo nível adquirido).
      Renderiza um 🎲 por ação disponível, usando o índice ORIGINAL. --}}
{{#if item._actionsView.length}}
<span class="lig-action-buttons">
  {{#each item._actionsView as |act|}}
  <button type="button" class="lig-roll-btn" data-action="itemRoll" data-action-index="{{act.index}}"
          title="{{#if act.label}}{{act.label}}{{else}}Ação {{act.index}}{{/if}}">🎲<span class="lig-roll-lbl">{{act.label}}</span></button>
  {{/each}}
</span>
{{/if}}
