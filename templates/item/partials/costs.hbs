{{!-- Partial: editor de custos. Espera {costs, costResources, editable} --}}
<div class="lig-costs">
  <div class="lig-section-title">
    Custos para usar
    <button type="button" class="lig-mini-btn" data-action="addCost">+ custo</button>
  </div>
  {{#each costs as |cost i|}}
  <div class="lig-cost-row {{#if ../hasLevels}}has-level{{/if}}">
    <select name="system.costs.{{i}}.resource">
      {{selectOptions ../costResources selected=cost.resource}}
    </select>
    <input type="text" name="system.costs.{{i}}.value" value="{{cost.value}}" class="lig-narrow"/>
    {{!-- ESTADO em que este custo vale (só onde o item tem níveis) --}}
    {{#if ../hasLevels}}
    <select name="system.costs.{{i}}.level" class="lig-costlevel" title="Quando este custo é cobrado, conforme o nível ATIVADO. &quot;Sempre&quot; vale em qualquer ativação; &quot;Só X&quot; vale apenas ativando em X; &quot;X + …&quot; cobra também os custos dos níveis abaixo.">
      {{selectOptions ../costLevels selected=cost.level}}
    </select>
    {{/if}}
    <input type="text" name="system.costs.{{i}}.label" value="{{cost.label}}" placeholder="nota"/>
    <button type="button" class="lig-mini-btn danger" data-action="removeCost" data-index="{{i}}">✕</button>
  </div>
  {{else}}
  <div class="lig-empty">Sem custos.</div>
  {{/each}}

  {{#if hasLevels}}
  <p class="lig-hint">Cada custo diz quando é cobrado, conforme o nível que for
    <strong>ativado</strong>. Os modos “+” somam os níveis abaixo: um custo em
    <em>Avançado + Básico</em> faz a ativação no Avançado cobrar os dois.</p>
  <div class="lig-cost-preview">
    <div class="lig-subtitle">Cobrança por nível de ativação</div>
    {{#each costPreview as |p|}}
    <div class="lig-cost-preview-row {{#if p.atual}}atual{{/if}}">
      <span class="lig-cost-preview-level">{{p.label}}</span>
      <span class="lig-cost-preview-val">{{p.texto}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}
</div>
