{{!-- Partial: alternador de modo passivo/ativo. Espera {system, editable} --}}
<div class="lig-mode-bar">
  <span class="lig-section-title">Modo</span>
  <label class="lig-radio">
    <input type="radio" name="system.mode" value="passive" {{#if (eq system.mode "passive")}}checked{{/if}}/>
    Passivo
  </label>
  <label class="lig-radio">
    <input type="radio" name="system.mode" value="active" {{#if (eq system.mode "active")}}checked{{/if}}/>
    Ativável
  </label>
  {{#if (eq system.mode "active")}}
  <label class="lig-inline-check lig-active-toggle" title="Atualmente ativo">
    <input type="checkbox" name="system.active" {{checked system.active}}/>
    Ligado
  </label>
  {{/if}}
</div>

{{#if (eq system.mode "active")}}
{{!-- Efeito visual enquanto o item estiver LIGADO --}}
<div class="lig-item-row">
  <label>Efeito visual enquanto ligado
    <input type="text" name="system.fxFile" value="{{system.fxFile}}" placeholder="ex.: jb2a.energy_field.02.above.blue" title="Caminho de um efeito do Sequencer (ex.: jb2a.shield.01.complete.blue). Fica preso ao token enquanto o item estiver ligado."/>
  </label>
  <label>Escala
    <input type="text" name="system.fxScale" value="{{system.fxScale}}" placeholder="1" title="Escala do efeito visual."/>
  </label>
</div>
{{!-- Puxar a animação do Automated Animations deste item como visual contínuo --}}
{{#if system.fxAaName}}
<div class="lig-macro-bound">
  <span class="lig-macro-name">🎞️ {{system.fxAaName}} — enquanto ligado</span>
  <button type="button" class="lig-mini-btn" data-action="pullFxAnim" title="Atualizar: copiar de novo a animação atual do item">↻</button>
  <button type="button" class="lig-mini-btn danger" data-action="clearFxAnim" title="Remover a animação puxada">✕</button>
</div>
<p class="lig-hint">O visual vem da animação do <strong>Automated Animations</strong> deste item e fica preso ao token <strong>enquanto o item estiver ligado</strong>.</p>
{{else}}
<button type="button" class="lig-mini-btn" data-action="pullFxAnim">🎞️ Puxar animação do item como visual contínuo</button>
<p class="lig-hint">Em vez de digitar o caminho acima, configure a animação no menu do <strong>Automated Animations</strong> e puxe: ela fica presa ao token enquanto o item estiver ligado.</p>
{{/if}}
{{/if}}
