<div class="ligeia-item-body equipamento">
  {{> systems/ligeia-rpg/templates/item/partials/header.hbs}}

  <div class="lig-item-row">
    <label>Categoria
      <input type="text" name="system.category" value="{{system.category}}" placeholder="Arma, Armadura, Suprimento..."/>
    </label>
    <label>Qtd.
      <input type="number" name="system.qty" value="{{system.qty}}" min="0"/>
    </label>
    <label>Peso
      <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/>
    </label>
    <label>Preço
      <input type="text" name="system.price" value="{{system.price}}" placeholder="ex: 50 Vo"/>
    </label>
  </div>

  {{!-- TIPAGENS: campo de etiquetas. Escolhe-se da lista do livro ou
        digita-se uma nova, que vira etiqueta na hora. Sem teto — uma arma
        carrega quantas quiser. --}}
  <div class="lig-tags-block">
    <div class="lig-section-title">
      Tipagens da arma
      {{#if tagsCount}}<span class="lig-tag-count">{{tagsCount}}</span>{{/if}}
    </div>
    <div class="lig-tagsel" data-allow-new="true">
      <div class="lig-tagsel-box">
        {{#each weaponTags as |tag|}}
        <span class="lig-tagsel-chip" data-tag="{{tag.id}}">
          {{tag.label}}
          <button type="button" class="lig-tagsel-x" title="Tirar esta tipagem">✕</button>
        </span>
        {{/each}}
        <input type="text" class="lig-tagsel-input" autocomplete="off"
               placeholder="{{#if weaponTags.length}}mais uma…{{else}}escolha ou digite uma tipagem…{{/if}}"/>
      </div>
      <div class="lig-tagsel-menu" hidden></div>
      <script type="application/json" class="lig-tagsel-data">{{{weaponTagOptionsJson}}}</script>
    </div>
    <p class="lig-hint">Escolha da lista ou digite uma nova e tecle Enter. Um efeito pode mirar
      <strong>Arma (qualquer tipagem)</strong> ou uma tipagem específica; tipagens
      diferentes somam seus bônus.</p>
  </div>

  <label class="lig-full">Notas / propriedades
    <input type="text" name="system.notes" value="{{system.notes}}" placeholder="Versátil, alcance, penalidade..."/>
  </label>

  <div class="lig-desc-block">
    <div class="lig-section-title">Descrição</div>
    {{#if editable}}
    <textarea name="system.description" rows="3">{{system.description}}</textarea>
    {{else}}<div class="lig-rendered">{{{enrichedDescription}}}</div>{{/if}}
  </div>

  {{> systems/ligeia-rpg/templates/item/partials/action.hbs}}
  {{> systems/ligeia-rpg/templates/item/partials/mode.hbs}}
  {{> systems/ligeia-rpg/templates/item/partials/effects.hbs}}
  {{> systems/ligeia-rpg/templates/item/partials/costs.hbs}}
</div>
